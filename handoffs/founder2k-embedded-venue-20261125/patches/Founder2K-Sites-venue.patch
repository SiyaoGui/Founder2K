+"use client";
+import { useEffect, useRef, useState } from "react";
+
+export default function DeviceCheck() {
+  const camera = useRef<HTMLVideoElement>(null),
+    capture = useRef<MediaStream | null>(null),
+    context = useRef<AudioContext | null>(null),
+    meter = useRef<HTMLMeterElement>(null);
+  const [message, setMessage] = useState(""),
+    [running, setRunning] = useState(false);
+  const frame = useRef(0);
+  function stop() {
+    capture.current?.getTracks().forEach((t) => t.stop());
+    capture.current = null;
+    if (camera.current) camera.current.srcObject = null;
+    cancelAnimationFrame(frame.current);
+    if (context.current) void context.current.close();
+    context.current = null;
+  }
+  useEffect(() => () => stop(), []);
+  async function test(video: boolean) {
+    stop();
+    try {
+      const stream = await navigator.mediaDevices.getUserMedia({
+        audio: true,
+        video,
+      });
+      capture.current = stream;
+      if (camera.current) camera.current.srcObject = stream;
+      const ac = new AudioContext();
+      context.current = ac;
+      const analyser = ac.createAnalyser();
+      ac.createMediaStreamSource(stream).connect(analyser);
+      const samples = new Uint8Array(analyser.fftSize);
+      function level() {
+        analyser.getByteTimeDomainData(samples);
+        if (meter.current)
+          meter.current.value =
+            Math.max(...samples.map((n) => Math.abs(n - 128))) / 128;
+        frame.current = requestAnimationFrame(level);
+      }
+      level();
+      setMessage("请说句话，确认音量条跳动。");
+      setRunning(true);
+    } catch {
+      stop();
+      setRunning(false);
+      setMessage("无法读取设备，请检查麦克风和摄像头权限。");
+    }
+  }
+  return (
+    <details
+      onToggle={(e) => {
+        if (!e.currentTarget.open) {
+          stop();
+          setRunning(false);
+        }
+      }}
+    >
+      <summary>入场前测试设备</summary>
+      <button type="button" onClick={() => void test(true)}>
+        测试摄像头和麦克风
+      </button>
+      <button type="button" onClick={() => void test(false)}>
+        只测试麦克风
+      </button>
+      <video
+        aria-label="本机摄像头预览"
+        ref={camera}
+        muted
+        autoPlay
+        playsInline
+        style={{ width: "100%", maxHeight: 200 }}
+      />
+      <label>
+        本机输入音量 <meter ref={meter} min={0} max={1} />
+      </label>
+      <p aria-live="polite">{message}</p>
+      {running && (
+        <button
+          type="button"
+          onClick={() => {
+            stop();
+            setRunning(false);
+            setMessage("设备测试结束");
+          }}
+        >
+          结束设备测试
+        </button>
+      )}
+    </details>
+  );
+}
diff --git a/app/venue/grouping.ts b/app/venue/grouping.ts
new file mode 100644
index 0000000..5fe51d6
--- /dev/null
+++ b/app/venue/grouping.ts
@@ -0,0 +1,93 @@
+export const roleTags = ["unset", "idea", "open", "builder", "seller"] as const;
+export type RoleTag = (typeof roleTags)[number];
+export const tagNames: Record<RoleTag, string> = {
+  unset: "待标注",
+  idea: "有 idea",
+  open: "无 idea · 方向待定",
+  builder: "Builder · 产品开发",
+  seller: "Seller · 销售",
+};
+export type GroupMember = {
+  id: string;
+  name: string;
+  tag: RoleTag;
+  group: string;
+  skills: string;
+};
+export type GroupMode = "balanced" | "random" | "alphabetical";
+export const ideaRoom = (id: string) => "idea/" + id;
+const names = new Intl.Collator("zh-CN-u-co-pinyin", {
+  sensitivity: "base",
+  numeric: true,
+});
+function shuffled<T>(items: T[]) {
+  const result = [...items];
+  for (let i = result.length - 1; i > 0; i--) {
+    const j = Math.floor(Math.random() * (i + 1));
+    [result[i], result[j]] = [result[j], result[i]];
+  }
+  return result;
+}
+// Each selected idea owner anchors a team. Existing members outside the selection
+// contribute to the counts and retain their assignments.
+export function distribute(
+  members: GroupMember[],
+  selected: Set<string>,
+  mode: GroupMode,
+): GroupMember[] {
+  const sorted = [...members].sort(
+    (a, b) => names.compare(a.name, b.name) || a.id.localeCompare(b.id),
+  );
+  const anchors = sorted.filter(
+    (m) =>
+      m.tag === "idea" && (selected.has(m.id) || m.group === ideaRoom(m.id)),
+  );
+  if (!anchors.length) throw Error("请先选择有 idea 的成员创建团队。");
+  const teams = mode === "random" ? shuffled(anchors) : anchors;
+  const counts = teams.map(() => ({
+    total: 0,
+    unset: 0,
+    idea: 0,
+    open: 0,
+    builder: 0,
+    seller: 0,
+  }));
+  const positions = new Map(teams.map((m, i) => [ideaRoom(m.id), i]));
+  const assigned = new Map<string, string>();
+  for (const m of members) {
+    const group =
+      m.tag === "idea" && selected.has(m.id) ? ideaRoom(m.id) : m.group;
+    if (m.tag === "idea" || !selected.has(m.id)) {
+      assigned.set(m.id, group);
+      const i = positions.get(group);
+      if (i !== undefined) {
+        counts[i][m.tag]++;
+        counts[i].total++;
+      }
+    }
+  }
+  const movable = sorted.filter(
+    (m) => selected.has(m.id) && !assigned.has(m.id),
+  );
+  const queue =
+    mode === "random"
+      ? shuffled(movable)
+      : mode === "alphabetical"
+        ? movable
+        : members.filter((m) => selected.has(m.id) && !assigned.has(m.id));
+  for (const m of queue) {
+    // Balance the scarcest role within the selection before total team size.
+    const best = counts.reduce(
+      (best, c, i) =>
+        c[m.tag] < counts[best][m.tag] ||
+        (c[m.tag] === counts[best][m.tag] && c.total < counts[best].total)
+          ? i
+          : best,
+      0,
+    );
+    counts[best][m.tag]++;
+    counts[best].total++;
+    assigned.set(m.id, ideaRoom(teams[best].id));
+  }
+  return members.map((m) => ({ ...m, group: assigned.get(m.id) || m.group }));
+}
diff --git a/app/venue/media-panel.tsx b/app/venue/media-panel.tsx
new file mode 100644
index 0000000..968e29c
--- /dev/null
+++ b/app/venue/media-panel.tsx
@@ -0,0 +1,244 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import {
+  Room,
+  RoomEvent,
+  Track,
+  createLocalAudioTrack,
+  createLocalScreenTracks,
+  type LocalTrack,
+  type RemoteTrack,
+} from "livekit-client";
+
+type Ticket = { url: string; token: string; publish: boolean };
+function attach(track: RemoteTrack, container: HTMLElement) {
+  const element = track.attach();
+  element.autoplay = true;
+  if (element instanceof HTMLVideoElement) element.playsInline = true;
+  element.dataset.track = track.sid || "";
+  container.appendChild(element);
+}
+export function MediaPanel({
+  channel,
+  ticket,
+  enabled,
+}: {
+  channel: string | null;
+  ticket: () => Promise<Ticket>;
+  enabled: boolean;
+}) {
+  const el = useRef<HTMLDivElement>(null),
+    session = useRef<Room | null>(null),
+    get = useRef(ticket);
+  get.current = ticket;
+  const [status, setStatus] = useState(""),
+    [retry, again] = useState(0),
+    [canSend, setCanSend] = useState(false),
+    [roster, setRoster] = useState<string[]>([]),
+    [mic, setMic] = useState(false),
+    [cam, setCam] = useState(false),
+    [screen, setScreen] = useState(false),
+    [audioOnly, setAudioOnly] = useState(false);
+  useEffect(() => {
+    setCanSend(false);
+    setRoster([]);
+    setMic(false);
+    setCam(false);
+    setScreen(false);
+    setAudioOnly(false);
+    setStatus("");
+    if (!enabled || !channel) return;
+    const room = new Room(),
+      container = el.current!;
+    let cancelled = false;
+    session.current = room;
+    const roster = () =>
+      setRoster(
+        [...room.remoteParticipants.values()].map((p) => p.name || "参会者"),
+      );
+    room
+      .on(RoomEvent.TrackSubscribed, (t) => {
+        if (!cancelled) attach(t, container);
+      })
+      .on(RoomEvent.TrackUnsubscribed, (t) =>
+        t.detach().forEach((e) => e.remove()),
+      )
+      .on(RoomEvent.ParticipantConnected, roster)
+      .on(RoomEvent.ParticipantDisconnected, roster)
+      .on(RoomEvent.Reconnecting, () => setStatus("正在重新连接"))
+      .on(RoomEvent.Reconnected, () => setStatus("已恢复连接"))
+      .on(RoomEvent.Disconnected, () => {
+        if (!cancelled) setStatus("连接已结束，请按议程重新进入");
+      });
+    (async () => {
+      try {
+        setStatus("正在连接");
+        const t = await get.current();
+        if (cancelled) return;
+        await room.connect(t.url, t.token);
+        if (cancelled) {
+          await room.disconnect();
+          return;
+        }
+        setCanSend(t.publish);
+        roster();
+        setStatus("媒体已连接");
+      } catch (e) {
+        if (!cancelled) setStatus(e instanceof Error ? e.message : "连接失败");
+      }
+    })();
+    return () => {
+      cancelled = true;
+      session.current = null;
+      void room.disconnect();
+      container.replaceChildren();
+    };
+  }, [channel, enabled, retry]);
+  async function control(which: string) {
+    const room = session.current;
+    if (!room) return;
+    try {
+      const lp = room.localParticipant;
+      if (which === "mic") {
+        await lp.setMicrophoneEnabled(!mic);
+        setMic(!mic);
+      }
+      if (which === "cam") {
+        await lp.setCameraEnabled(!cam);
+        setCam(!cam);
+      }
+      if (which === "screen") {
+        await lp.setScreenShareEnabled(!screen);
+        setScreen(!screen);
+      }
+      if (which === "audio") {
+        for (const p of room.remoteParticipants.values())
+          for (const track of p.videoTrackPublications.values())
+            track.setSubscribed(audioOnly);
+        setAudioOnly(!audioOnly);
+      }
+      if (which === "play") await room.startAudio();
+    } catch {
+      setStatus("设备或播放权限不可用，请检查浏览器权限后重试");
+    }
+  }
+  return (
+    <>
+      <div className="venue-tracks" ref={el} />
+      <p aria-live="polite">{status}</p>
+      {roster.length > 0 && <p>同场 · {roster.join("、")}</p>}
+      {enabled && channel && (
+        <div className="venue-actions">
+          <button onClick={() => control("play")}>播放声音</button>
+          <button onClick={() => control("audio")}>
+            {audioOnly ? "恢复视频" : "纯音频"}
+          </button>
+          {canSend && (
+            <>
+              <button onClick={() => control("mic")}>
+                {mic ? "关闭麦克风" : "开启麦克风"}
+              </button>
+              <button onClick={() => control("cam")}>
+                {cam ? "关闭摄像头" : "开启摄像头"}
+              </button>
+              <button onClick={() => control("screen")}>
+                {screen ? "结束共享" : "共享屏幕"}
+              </button>
+            </>
+          )}
+          <button onClick={() => again((v) => v + 1)}>重新连接</button>
+        </div>
+      )}
+    </>
+  );
+}
+
+export function Presenter({
+  targets,
+  ticket,
+}: {
+  targets: { id: string; epoch: string }[];
+  ticket: (id: string) => Promise<Ticket>;
+}) {
+  const rooms = useRef(new Map<string, Room>()),
+    tracks = useRef<LocalTrack[]>([]),
+    [running, setRunning] = useState(false),
+    [error, setError] = useState("");
+  const current = useRef(ticket);
+  current.current = ticket;
+  const signature = JSON.stringify(targets);
+  function stop() {
+    tracks.current.forEach((t) => t.stop());
+    tracks.current = [];
+    rooms.current.forEach((r) => void r.disconnect(false));
+    rooms.current.clear();
+  }
+  useEffect(() => () => stop(), []);
+  useEffect(() => {
+    if (!running) return;
+    let cancelled = false;
+    const targets = JSON.parse(signature) as { id: string; epoch: string }[],
+      wanted = new Set(targets.map((t) => t.epoch));
+    for (const [key, room] of rooms.current)
+      if (!wanted.has(key)) {
+        rooms.current.delete(key);
+        void room.disconnect(false);
+      }
+    (async () => {
+      for (const t of targets) {
+        if (cancelled || rooms.current.has(t.epoch)) continue;
+        const room = new Room();
+        try {
+          const a = await current.current(t.id);
+          if (cancelled) return;
+          await room.connect(a.url, a.token);
+          if (cancelled) {
+            await room.disconnect(false);
+            return;
+          }
+          rooms.current.set(t.epoch, room);
+          for (const tr of tracks.current)
+            await room.localParticipant.publishTrack(
+              tr.mediaStreamTrack.clone(),
+              { source: tr.source },
+            );
+        } catch {
+          await room.disconnect();
+          rooms.current.delete(t.epoch);
+          if (!cancelled) setError("部分组演示未连通，请检查网络并重新分发");
+        }
+      }
+    })();
+    return () => {
+      cancelled = true;
+    };
+  }, [signature, running]);
+  async function start() {
+    try {
+      const capture = await createLocalScreenTracks({ audio: false });
+      tracks.current = capture;
+      const mic = await createLocalAudioTrack();
+      mic.source = Track.Source.Microphone;
+      tracks.current.push(mic);
+      setError("");
+      setRunning(true);
+      capture[0].mediaStreamTrack.onended = () => {
+        stop();
+        setRunning(false);
+      };
+    } catch {
+      stop();
+      setError("请允许共享演示画面和麦克风");
+    }
+  }
+  return (
+    <>
+      <button
+        onClick={() => (running ? (stop(), setRunning(false)) : void start())}
+      >
+        {running ? "停止演示分发" : "共享演示与主持人声音"}
+      </button>
+      {error && <p role="alert">{error}</p>}
+    </>
+  );
+}
