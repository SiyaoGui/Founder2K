+        const fresh = latest && (JSON.parse(latest.data) as Control);
+        if (
+          !fresh ||
+          fresh.groups[group]?.epoch !== c.groups[group].epoch ||
+          fresh.groups[group]?.closing
+        ) {
+          await closeRoom(ticket.room);
+          throw new VenueError(409, "团队已调整，请重新进入");
+        }
+        return reply(ticket);
+      }
+      const state = (id: string, mId: string) => {
+        const x = pres.get(id);
+        if (!x) return "尚未签到";
+        if (x.left) return "已离场";
+        if (now - x.at > 45000) return "状态待确认";
+        const l = live.find(
+          (l) =>
+            l.media_generation &&
+            (l.host_account === person(id)?.account ||
+              l.visitor_account === person(id)?.account),
+        );
+        if (l)
+          return l.id !== mId
+            ? "仍在上一场"
+            : l.media_connected_ms
+              ? "双方已连入"
+              : "正在连接";
+        return x.early === mId ? "已点击准备好" : "已签到";
+      };
+      const agenda = Array.from(
+        {
+          length:
+            s.format === "导师答疑"
+              ? Math.max(0, ...own.map((m) => m.round))
+              : s.matching
+                ? 6
+                : 0,
+        },
+        (_, i) => {
+          const r = i + 1,
+            m = own.find((m) => m.round === r);
+          const slot = {
+            round: r,
+            planned: begin(r),
+            start: m ? starts(m) : begin(r),
+            end: m ? end(m) : begin(r) + c.duration * 60000,
+          };
+          if (!m) return { ...slot, empty: true };
+          const other = m.lead === me ? m.partner : m.lead,
+            l = live.find((l) => l.id === mid(m));
+          return {
+            ...slot,
+            id: mid(m),
+            peer: other,
+            name: label(other),
+            verified: c.verified?.includes(other),
+            topic: person(m.lead)?.topic,
+            status: state(other, mid(m)),
+            updated: pres.get(other)?.at,
+            actual: l?.media_connected_ms,
+            closed: l?.media_closed_ms,
+            skipped: p?.skip === mid(m) || p?.skipped?.includes(mid(m)),
+          };
+        },
+      );
+      const signals = await sql
+        .prepare(
+          "SELECT id,state FROM her_entries WHERE kind='venue-signal' AND target=?",
+        )
+        .bind(a.id)
+        .all<{ id: string; state: string }>();
+      const rooms = Object.entries(c.groups)
+        .filter(([, g]) => admin || dispatcher || g.manager === me)
+        .map(([id, g]) => {
+          const list = s.meetings.filter(
+            (m) =>
+              m.lead === id &&
+              end(m) > now &&
+              !live.find((l) => l.id === mid(m))?.media_closed_ms,
+          );
+          const m = list.sort((a, b) => a.round - b.round)[0],
+            l = live.find((l) => l.logical_room === id && l.media_generation);
+          const waited =
+            m && !l && pres.get(id) && !pres.get(id)!.left
+              ? Math.max(0, now - Math.max(starts(m), pres.get(id)!.entered))
+              : 0;
+          return {
+            id,
+            label:
+              (flash && teamLabel(id)) ||
+              label(id) ||
+              (id === "auditorium" ? "路演舞台" : "") ||
+              s.people.find((p) => p.group === id)?.topic ||
+              "分组",
+            signal:
+              signals.results.find((r) => r.id === "signal/" + stage(id))
+                ?.state || "待接收演示",
+            managerOffline:
+              !pres.has(g.manager) ||
+              !!pres.get(g.manager)?.left ||
+              now - pres.get(g.manager)!.at >= 45000,
+            mode: g.mode,
+            handoff: g.handoff,
+            epoch: g.epoch,
+            manager: person(g.manager)?.name || "总主持人",
+            scheduledRound: m?.round,
+            round: l ? Number(l.id.split(".")[1]) : 0,
+            active: l
+              ? [l.host_account, l.visitor_account]
+                  .map(
+                    (account) =>
+                      s.people.find((p) => p.account === account)?.name,
+                  )
+                  .join("、")
+              : "",
+            next: (l ? list.find((q) => mid(q) !== l.id) : m)
+              ? person((l ? list.find((q) => mid(q) !== l.id) : m)!.partner)
+                  ?.name
+              : "",
+            waited,
+            help: s.people
+              .filter(
+                (p) =>
+                  (p.group === id || p.id === m?.partner) &&
+                  pres.get(p.id)?.help,
+              )
+              .map((p) => ({
+                id: p.id,
+                text: p.name + " · " + pres.get(p.id)!.help,
+              })),
+          };
+        });
+      const followups = Object.values(c.followups || {})
+        .filter((f) => f.from === me || f.to === me)
+        .map((f) => {
+          const peer = f.from === me ? f.to : f.from;
+          return {
+            peer,
+            name: person(peer)?.name,
+            received: f.to === me,
+            choice: f.choice,
+            agreed: f.agreed,
+          };
+        });
+      return reply({
+        rehearsalOf: s.rehearsalOf,
+        latestRehearsal:
+          !s.rehearsalOf && (!p || p.left || p.device !== a.device)
+            ? (
+                await sql
+                  .prepare(
+                    "SELECT id FROM her_entries WHERE kind='venue-rehearsal' AND target=? ORDER BY updated DESC LIMIT 1",
+                  )
+                  .bind(a.id)
+                  .first<{ id: string }>()
+              )?.id
+            : undefined,
+        verified: !!c.verified?.includes(me),
+        followups,
+        pitchContacts:
+          s.format === "路演"
+            ? (c.formerSpeakers || []).map((id) => ({
+                id,
+                name: person(id)?.name,
+              }))
+            : [],
+        format: s.format,
+        queueAhead: (c.queue || []).indexOf(me),
+        onStage: (c.speakers || []).includes(me),
+        queue: admin ? c.queue || [] : [],
+        teamRoster:
+          admin && flash
+            ? s.people
+                .filter((m) => m.role !== "旁听")
+                .map((m) => ({
+                  id: m.id,
+                  name: label(m.id),
+                  skills: m.skills || "",
+                  tag: c.teamPlan?.[m.id]?.tag || "unset",
+                  group: m.group,
+                }))
+            : undefined,
+        teamName: flash
+          ? teamLabel(group) ||
+            s.people.find((m) => m.group === group)?.topic ||
+            "团队"
+          : undefined,
+        title: s.title,
+        name,
+        me,
+        role: self?.role || "总主持人",
+        admin,
+        matching: s.matching,
+        checked: !!p && !p.left && p.device === a.device,
+        now,
+        revision: c.rev,
+        notice: c.notice,
+        wait: c.wait,
+        automatic: p?.automatic,
+        agenda,
+        rooms,
+        group,
+        visits: Object.entries(c.visits || {})
+          .filter(
+            ([, v]) =>
+              admin ||
+              self?.group === v.group ||
+              c.groups[v.group]?.manager === me,
+          )
+          .map(([id, v]) => ({ member: id, name: person(id)?.name, ...v })),
+        visitOptions:
+          s.format === "创业快闪" && self?.role !== "旁听"
+            ? Object.keys(c.groups)
+                .filter((k) => !["lobby", "audience", self?.group].includes(k))
+                .map((id) => ({
+                  id,
+                  label: s.people.find((p) => p.group === id)?.topic || "团队",
+                }))
+            : [],
+        mode: c.groups[group]?.mode,
+        manager: person(c.groups[group]?.manager)?.name || "总主持人",
+        handoff: c.groups[group]?.handoff,
+        media: available(),
+        mediaKey:
+          flash && admin && !self
+            ? null
+            : (active &&
+              (p?.joined === active.id ||
+                p?.early === active.id ||
+                p?.automatic)
+                ? active.media_generation
+                : null) ||
+              (group && c.groups[group]
+                ? c.groups[group].mode === "stage"
+                  ? stage(group)
+                  : !s.matching &&
+                      s.format === "创业快闪" &&
+                      self?.role !== "旁听" &&
+                      group !== "audience" &&
+                      group !== "lobby"
+                    ? team(group)
+                    : null
+                : null),
+        active:
+          active &&
+          (p?.joined === active.id || p?.early === active.id || p?.automatic)
+            ? active.id
+            : null,
+        current: current?.round,
+        dispatcher,
+        dispatchers: admin ? c.dispatchers || [] : [],
+        helpers: admin ? s.people.map((p) => ({ id: p.id, name: p.name })) : [],
+      });
+    }
+    // Housekeeping may close a prior generation. Reload state and execute the
+    // original command before acknowledging it to the participant.
+    for (let attempt = 0; attempt < 4; attempt++) {
+      const result = await dispatch();
+      if (result) return result;
+    }
+    throw new VenueError(409, "会场刚有更新，请重试");
+  } catch (e) {
+    return reply(
+      {
+        error:
+          e instanceof VenueError
+            ? e.message
+            : e instanceof z.ZodError
+              ? "操作参数有误"
+              : "会场服务暂不可用",
+      },
+      e instanceof VenueError ? e.status : e instanceof z.ZodError ? 400 : 503,
+    );
+  }
+}
diff --git a/app/api/venue/source.ts b/app/api/venue/source.ts
new file mode 100644
index 0000000..d40e222
--- /dev/null
+++ b/app/api/venue/source.ts
@@ -0,0 +1,129 @@
+import { env } from "cloudflare:workers";
+import type { Member, Meeting } from "../../women-matching";
+
+export type Person = Pick<Member, "name" | "topic" | "id"> & {
+  account: string;
+  skills?: string;
+  role: string;
+  group: string;
+};
+export type Source = {
+  title: string;
+  start: number;
+  people: Person[];
+  meetings: Meeting[];
+  matching: boolean;
+  format: string;
+  rehearsalOf?: string;
+};
+export class VenueError extends Error {
+  constructor(
+    public status: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+export function requireVenue(
+  value: unknown,
+  status: number,
+  message: string,
+): asserts value {
+  if (!value) throw new VenueError(status, message);
+}
+
+export async function readSource(id: string): Promise<Source> {
+  const run = await env
+    .DB!.prepare(
+      "SELECT target,updated FROM her_entries WHERE kind='venue-rehearsal' AND id=?",
+    )
+    .bind(id)
+    .first<{ target: string; updated: number }>();
+  const source = await readActivity(run?.target || id);
+  return run
+    ? {
+        ...source,
+        title: source.title + " · 彩排",
+        start: run.updated,
+        rehearsalOf: run.target,
+      }
+    : source;
+}
+
+async function readActivity(id: string): Promise<Source> {
+  const db = env.DB!;
+  const program = await db
+    .prepare("SELECT data FROM her_entries WHERE kind='women-program' AND id=?")
+    .bind(id)
+    .first<{ data: string }>();
+  if (program) {
+    const session = JSON.parse(program.data) as {
+      published: boolean;
+      title: string;
+      start: string;
+      members: (Member & { account: string })[];
+      meetings: Meeting[];
+    };
+    requireVenue(session.published, 409, "请先发布本场排班");
+    return {
+      title: session.title,
+      start: Date.parse(session.start),
+      matching: true,
+      format: "女性共创",
+      meetings: session.meetings,
+      people: session.members.map(({ id, account, name, role, topic }) => ({
+        id,
+        account,
+        name,
+        role,
+        topic,
+        group:
+          role === "项目发起人"
+            ? id
+            : session.meetings.find((m) => m.partner === id)?.lead || "",
+      })),
+    };
+  }
+  const cohort = await db
+    .prepare(
+      "SELECT payload FROM platform_items WHERE kind='cohort' AND id=? AND status IN ('open','closed')",
+    )
+    .bind(id)
+    .first<{ payload: string }>();
+  requireVenue(cohort, 404, "找不到这场活动");
+  const c = JSON.parse(cohort.payload);
+  const { results } = await db
+    .prepare(
+      `SELECT a.id,a.owner,a.payload,(SELECT t.id FROM platform_items t WHERE t.kind='team' AND t.parent=a.parent
+    AND (t.owner=a.owner OR EXISTS (SELECT 1 FROM platform_items i WHERE i.kind='invite' AND i.status='accepted' AND i.parent=t.id AND i.owner=a.owner)) ORDER BY t.id LIMIT 1) AS team
+    FROM platform_items a WHERE a.kind='application' AND a.status='admitted' AND a.parent=?`,
+    )
+    .bind(id)
+    .all<{ id: string; owner: string; payload: string; team: string | null }>();
+  return {
+    title: c.title,
+    start: Date.parse(c.start),
+    matching: c.venueFormat === "导师答疑",
+    format: c.venueFormat || "创业快闪",
+    meetings: [],
+    people: results.map((r) => {
+      const p = JSON.parse(r.payload);
+      return {
+        id: r.id,
+        account: r.owner,
+        name: p.name,
+        role: p.role,
+        topic: p.goal,
+        skills: p.skills || "",
+        group:
+          c.venueFormat === "路演"
+            ? "auditorium"
+            : c.venueFormat === "导师答疑"
+              ? ""
+              : p.role === "旁听"
+                ? "audience"
+                : r.team || "lobby",
+      };
+    }),
+  };
+}
